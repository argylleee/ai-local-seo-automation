{
  "name": "06_send_report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 1 * *" }]
        }
      },
      "id": "schedule-trigger",
      "name": "Monthly 1st 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "business-id",
              "name": "businessId",
              "type": "string",
              "value": "REPLACE_WITH_BUSINESS_ID"
            },
            {
              "id": "recipient",
              "name": "recipientEmail",
              "type": "string",
              "value": "REPLACE_WITH_YOUR_EMAIL"
            }
          ]
        }
      },
      "id": "set-params",
      "name": "Params",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/internal/businesses/{{ $json.businessId }}/report-summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-secret", "value": "={{ $env.N8N_INTERNAL_SECRET }}" }
          ]
        }
      },
      "id": "http-request",
      "name": "Fetch Report Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 0]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst scoreRows = (data.scoreHistory || [])\n  .map((r) => `${r.completedAt ?? ''} (${r.source}): ${r.score}`)\n  .join('\\n');\nconst issueRows = Object.entries(data.issuesByCategory || {})\n  .map(([category, count]) => `${category}: ${count}`)\n  .join('\\n');\nconst rec = data.recommendationCounts || {};\nconst body = `SEO report for ${data.business?.name ?? 'your business'}\\n\\nScore history:\\n${scoreRows || 'No completed audits yet.'}\\n\\nOpen issues by category:\\n${issueRows || 'None.'}\\n\\nRecommendations — pending: ${rec.pending ?? 0}, approved: ${rec.approved ?? 0}, rejected: ${rec.rejected ?? 0}, completed: ${rec.completed ?? 0}`;\nreturn [{ json: { ...($('Params').first().json), emailBody: body } }];"
      },
      "id": "format-email",
      "name": "Format Email Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "fromEmail": "REPLACE_WITH_SENDER_EMAIL",
        "toEmail": "={{ $json.recipientEmail }}",
        "subject": "Monthly SEO Report",
        "text": "={{ $json.emailBody }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [560, 0],
      "credentials": {
        "smtp": { "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID", "name": "SMTP account" }
      }
    },
    {
      "parameters": {
        "content": "This workflow doesn't report to /api/internal/automation-runs/:id/events because nothing creates an automation_runs row for a plain report-send (unlike 01/03, which get one for free from createRunningAudit). It won't show up on the Dashboard's 'Recent automation runs' card. If you want that, ask for a small new endpoint that creates+completes an automation_runs row around this workflow — not built, since it wasn't asked for. See n8n/docs/06_send_report.md.",
        "height": 220,
        "width": 320
      },
      "id": "note-tracking",
      "name": "Sticky Note: No run tracking",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [560, -260]
    }
  ],
  "connections": {
    "Monthly 1st 08:00": { "main": [[{ "node": "Params", "type": "main", "index": 0 }]] },
    "Params": { "main": [[{ "node": "Fetch Report Summary", "type": "main", "index": 0 }]] },
    "Fetch Report Summary": {
      "main": [[{ "node": "Format Email Body", "type": "main", "index": 0 }]]
    },
    "Format Email Body": { "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
