{
  "name": "local-seo-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@local-seo/db": "workspace:*",
    "@local-seo/integrations": "workspace:*",
    "@local-seo/seo-engine": "workspace:*",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.19.0",
    "prettier": "^3.4.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0"
  }
}
